{
  "name": "memoriahub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm -w apps/api",
    "web": "npm -w apps/web",
    "api:dev": "npm -w apps/api run start:dev",
    "web:dev": "npm -w apps/web run dev",
    "api:test": "npm -w apps/api test",
    "web:test": "npm -w apps/web test",
    "credentials:migrate-legacy": "npm -w apps/api run credentials:migrate-legacy --",
    "db-backup:migrate-legacy": "npm -w apps/api run db-backup:migrate-legacy --",
    "audit:triage": "node scripts/audit-triage.mjs",
    "openapi:dump": "npm run openapi:dump --workspace=api -- ../../openapi.json",
    "openapi:lint": "spectral lint openapi.json --ruleset .spectral.yaml --fail-severity=error",
    "postinstall": "node scripts/patch-react-transition-group.js",
    "check:platform-pin": "node scripts/check-platform-pin.mjs",
    "platform:infra:sync": "platform-infra sync",
    "check:single-instance": "node scripts/memoriahub-packages/check-single-instance.mjs --root . --guard '@marinoscar/platform-*' --guard '@marinoscar/memoriahub-*'",
    "check:platform-imports": "eslint --max-warnings=0 \"apps/{api,web,cli}/src/**/*.{ts,tsx}\"",
    "build:memoriahub-packages": "npm run build -w @marinoscar/memoriahub-compute && npm run build -w @marinoscar/memoriahub-contract && npm run build -w @marinoscar/memoriahub-db && npm run build -w @marinoscar/memoriahub-api && npm run build -w @marinoscar/memoriahub-web",
    "typecheck:memoriahub-packages": "npm run typecheck -w @marinoscar/memoriahub-compute && npm run typecheck -w @marinoscar/memoriahub-contract && npm run typecheck -w @marinoscar/memoriahub-db && npm run typecheck -w @marinoscar/memoriahub-api && npm run typecheck -w @marinoscar/memoriahub-web",
    "test:memoriahub-packages": "npm run test:run -w @marinoscar/memoriahub-compute && npm run test:run -w @marinoscar/memoriahub-contract && npm run test:run -w @marinoscar/memoriahub-db && npm run test:run -w @marinoscar/memoriahub-api && npm run test:run -w @marinoscar/memoriahub-web",
    "docs:memoriahub-packages": "npm run docs -w @marinoscar/memoriahub-compute && npm run docs -w @marinoscar/memoriahub-contract && npm run docs -w @marinoscar/memoriahub-db && npm run docs -w @marinoscar/memoriahub-api && npm run docs -w @marinoscar/memoriahub-web",
    "test:memoriahub-scripts": "node --test \"scripts/memoriahub-packages/test/*.test.mjs\"",
    "check:memoriahub-slice-peers": "node scripts/memoriahub-packages/check-slice-peers.mjs && node scripts/memoriahub-packages/check-slice-peers.mjs --app apps/api --app apps/cli --app apps/web",
    "check:memoriahub-package-docs": "npm run docs:memoriahub-packages && node scripts/memoriahub-packages/check-package-docs.mjs",
    "check:memoriahub-pack": "node scripts/memoriahub-packages/check-package-pack.mjs",
    "check:memoriahub-lean-install": "node scripts/memoriahub-packages/check-lean-install.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "lint:memoriahub-packages": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"packages/memoriahub-*/src/**/*.{ts,tsx}\""
  },
  "overrides": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/swagger": {
      ".": "^11.4.6",
      "js-yaml": "^5.2.2"
    },
    "@fastify/static": "^10.1.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "onnxruntime-node": "1.27.0",
    "tesseract.js": "7.0.0",
    "@marinoscar/platform-contract": "$@marinoscar/platform-contract"
  },
  "dependencies": {
    "ink": "^7.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@marinoscar/platform-contract": "0.1.0-next.29",
    "@marinoscar/platform-infra": "0.1.0-next.29",
    "@stoplight/spectral-cli": "^6.16.3",
    "eslint": "^10.12.0",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.71.2"
  }
}
