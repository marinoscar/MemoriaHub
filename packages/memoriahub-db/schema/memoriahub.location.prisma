// =============================================================================
// Location Inference
// =============================================================================

enum LocationSuggestionStatus {
  pending
  accepted
  rejected
  auto_applied
  reverted
}

// LocationSuggestion holds one interpolated/nearest-anchor coordinate guess per
// media item that lacks EXIF GPS but has timeline neighbors with coordinates.
// anchorBeforeId / anchorAfterId are intentionally plain nullable UUID columns
// (no Prisma relation, no DB-level FK) — mirrors the media_visual_embedding.circle_id
// "denormalized, no FK" precedent — so deleting the referenced anchor media item
// never blocks or cascades against this row.
model LocationSuggestion {
  id               String                   @id @default(uuid()) @db.Uuid
  mediaItemId      String                   @unique @map("media_item_id") @db.Uuid
  circleId         String                   @map("circle_id") @db.Uuid
  // RETRO-I2 (#569): ownership (docs/platform-adoption/circles-to-groups.md §3). Derived from
  // circle_id by the trigger mh_content_owner_from_circle while circles decide access (until
  // RETRO-I3); CHECK num_nonnulls(owner_user_id, owner_group_id) = 1 and FORCE RLS are raw SQL.
  orgId        String  @default(dbgenerated("mh_default_org_id()")) @map("org_id") @db.Uuid
  ownerGroupId String? @map("owner_group_id") @db.Uuid
  // PLATFORM-ADOPTION-SHIM(#573): the FK owner_user_id -> users(id) ON DELETE RESTRICT exists in the
  // database but is not modelled: the user-owned registry cannot mix a Restrict key with this
  // model's SetNull actor keys (docs/platform-adoption/local-exceptions.md).
  ownerUserId  String? @map("owner_user_id") @db.Uuid
  lat              Float
  lng              Float
  confidence       Float
  method           String // 'interpolated' | 'nearest'
  anchorBeforeId   String?                  @map("anchor_before_id") @db.Uuid
  anchorAfterId    String?                  @map("anchor_after_id") @db.Uuid
  gapBeforeSeconds Int?                     @map("gap_before_seconds")
  gapAfterSeconds  Int?                     @map("gap_after_seconds")
  anchorDistanceKm Float?                   @map("anchor_distance_km")
  impliedSpeedKmh  Float?                   @map("implied_speed_kmh")
  status           LocationSuggestionStatus @default(pending)
  resolvedById     String?                  @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?                @map("resolved_at") @db.Timestamptz
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  mediaItem      MediaItem       @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  resolvedBy     User?           @relation("LocationSuggestionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  // Migrated from LocationSuggestionRunItem[] to the shared ReviewRunItem
  // table in migration 20260726010000_review_runs (issue #190) — see the
  // Review Runs section below.
  reviewRunItems ReviewRunItem[]

  // RETRO-I2 (#569): the owning organization and group (composite key, a foreign-key check bypasses RLS).
  org        Organization @relation("LocationSuggestionOrg", fields: [orgId], references: [id], onDelete: Restrict)
  ownerGroup Group?       @relation("LocationSuggestionOwnerGroup", fields: [ownerGroupId, orgId], references: [id, orgId], onDelete: Restrict)

  @@index([circleId, status])
  @@index([ownerGroupId])
  @@index([ownerUserId])
  @@map("location_suggestions")
}

// =============================================================================
// Location Grouping (issue #373)
// =============================================================================
// Merges the raw, ungoverned strings a reverse-geocoder produces (geoCountry
// / geoAdmin1 / geoLocality on MediaItem) into a small set of admin-curated
// canonical groups — e.g. "NYC" / "New York City" / "Manhattan, NY" all
// resolving to one "New York City" group — so browsing-by-location isn't
// fragmented by geocoder spelling variance. A group's aliases are the raw
// strings that resolve to it; a raw string with no alias resolves to itself
// (the geoCanonical* columns on MediaItem still get populated per the
// invariant documented on those columns above).

enum LocationGroupLevel {
  country
  region
  locality
}

model LocationGroup {
  id String @id @default(uuid()) @db.Uuid

  level          LocationGroupLevel
  canonicalName  String             @map("canonical_name")
  normalizedName String             @map("normalized_name")

  // NOT NULL, DEFAULT '' — never nullable. Postgres unique indexes treat
  // every NULL as distinct from every other NULL, so a nullable scope column
  // here would silently permit two country-level groups both named
  // "Georgia" (the country vs. the US state normalizing the same) to
  // coexist under @@unique below instead of being caught — the same pitfall
  // documented on Memory.subjectKey and notifications_review_queue_live_uniq_idx.
  countryCode String @default("") @map("country_code")

  // SetNull (not Cascade): a hard-deleted cover photo must not take the
  // whole group down with it — mirrors Album.coverMediaItemId /
  // Memory.coverMediaItemId.
  coverMediaItemId String? @map("cover_media_item_id") @db.Uuid

  centerLat Float? @map("center_lat")
  centerLng Float? @map("center_lng")
  radiusKm  Float? @map("radius_km")

  enabled Boolean @default(true)
  notes   String?

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  coverMediaItem MediaItem?           @relation("LocationGroupCover", fields: [coverMediaItemId], references: [id], onDelete: SetNull)
  createdBy      User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  aliases        LocationGroupAlias[]

  @@unique([level, countryCode, normalizedName])
  @@index([level, enabled])
  @@index([coverMediaItemId])
  @@map("location_groups")
}

model LocationGroupAlias {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid

  // Denormalized from the parent LocationGroup; never independently edited —
  // an alias always describes the group it belongs to, so re-deriving these
  // per row (instead of joining) is what lets the unique constraint below
  // scope resolution by (level, countryCode) without a join.
  level       LocationGroupLevel
  countryCode String             @default("") @map("country_code")

  rawValue        String @map("raw_value") // the geocoder string exactly as it was stored on media_items
  normalizedValue String @map("normalized_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  group LocationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // LOAD-BEARING: a raw value belongs to at most one group. Without this,
  // resolution of a raw geocoder string to a group would be ambiguous
  // whenever two admins (or the same admin twice) aliased the same raw
  // string to different groups.
  @@unique([level, countryCode, normalizedValue])
  @@index([groupId])
  @@map("location_group_aliases")
}
