{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["../../typedoc.base.json"],
  "tsconfig": "./tsconfig.build.json",
  "entryPoints": [
    "./src/core/headless/index.ts",
    "./src/core/ui/index.ts",
    "./src/core/testing/index.ts",
    "./src/brand/index.ts",
    "./src/shell/index.ts",
    "./src/media/headless/index.ts",
    "./src/media/ui/index.ts",
    "./src/people/headless/index.ts",
    "./src/people/ui/index.ts",
    "./src/memories/headless/index.ts",
    "./src/memories/ui/index.ts",
    "./src/search/headless/index.ts",
    "./src/search/ui/index.ts",
    "./src/tagging/headless/index.ts",
    "./src/tagging/ui/index.ts",
    "./src/workflows/headless/index.ts",
    "./src/workflows/ui/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "name": "@marinoscar/memoriahub-web",
  "out": "./docs-api/html",
  "json": "./docs-api/api.json",
  // The shared list minus "Property". Option and result interfaces carry their
  // meaning in the TSDoc of the interface and of the method that takes or
  // returns them; every exported declaration still needs TSDoc and `@stability`.
  "requiredToBeDocumented": [
    "Namespace",
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "Accessor",
    "TypeAlias"
  ]
}
