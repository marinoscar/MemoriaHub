{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["../../typedoc.base.json"],
  "tsconfig": "./tsconfig.build.json",
  "entryPoints": [
    "./src/ports/index.ts",
    "./src/core/index.ts",
    "./src/testing/index.ts",
    "./src/media/index.ts",
    "./src/media/testing/index.ts",
    "./src/insights/index.ts",
    "./src/insights/testing/index.ts",
    "./src/location/index.ts",
    "./src/location/testing/index.ts",
    "./src/dedup/index.ts",
    "./src/dedup/testing/index.ts",
    "./src/face/index.ts",
    "./src/face/testing/index.ts",
    "./src/tagging/index.ts",
    "./src/tagging/testing/index.ts",
    "./src/search/index.ts",
    "./src/search/testing/index.ts",
    "./src/review-runs/index.ts",
    "./src/review-runs/testing/index.ts",
    "./src/workflows/index.ts",
    "./src/workflows/testing/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "name": "@marinoscar/memoriahub-api",
  "out": "./docs-api/html",
  "json": "./docs-api/api.json",
  // The shared list minus "Property". Option and result interfaces carry their
  // meaning in the TSDoc of the interface and of the method that takes or
  // returns them; every exported declaration still needs TSDoc and `@stability`.
  "requiredToBeDocumented": [
    "Namespace",
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "Accessor",
    "TypeAlias"
  ]
}
