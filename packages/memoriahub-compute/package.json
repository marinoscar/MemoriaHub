{
  "name": "@marinoscar/memoriahub-compute",
  "version": "0.0.0",
  "description": "Pure enrichment compute for MemoriaHub (image prep, CLIP embedding, dHash, EXIF/video metadata, CompreFace and OCR helpers, node result DTOs), imported identically by the API and a worker node so node-computed vectors are numerically identical to server-computed ones. Platform-free; dual CommonJS + ESM.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/MemoriaHub.git",
    "directory": "packages/memoriahub-compute"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./image": {
      "types": "./dist/types/image/index.d.ts",
      "import": "./dist/esm/image/index.js",
      "require": "./dist/cjs/image/index.js"
    },
    "./geo": {
      "types": "./dist/types/geo/index.d.ts",
      "import": "./dist/esm/geo/index.js",
      "require": "./dist/cjs/geo/index.js"
    },
    "./rate-limit": {
      "types": "./dist/types/rate-limit/index.d.ts",
      "import": "./dist/esm/rate-limit/index.js",
      "require": "./dist/cjs/rate-limit/index.js"
    },
    "./clip": {
      "types": "./dist/types/clip/index.d.ts",
      "import": "./dist/esm/clip/index.js",
      "require": "./dist/cjs/clip/index.js"
    },
    "./dhash": {
      "types": "./dist/types/dhash/index.d.ts",
      "import": "./dist/esm/dhash/index.js",
      "require": "./dist/cjs/dhash/index.js"
    },
    "./ffmpeg": {
      "types": "./dist/types/ffmpeg/index.d.ts",
      "import": "./dist/esm/ffmpeg/index.js",
      "require": "./dist/cjs/ffmpeg/index.js"
    },
    "./dto": {
      "types": "./dist/types/dto/index.d.ts",
      "import": "./dist/esm/dto/index.js",
      "require": "./dist/cjs/dto/index.js"
    },
    "./face-compreface": {
      "types": "./dist/types/face-compreface/index.d.ts",
      "import": "./dist/esm/face-compreface/index.js",
      "require": "./dist/cjs/face-compreface/index.js"
    },
    "./face-video": {
      "types": "./dist/types/face-video/index.d.ts",
      "import": "./dist/esm/face-video/index.js",
      "require": "./dist/cjs/face-video/index.js"
    },
    "./ocr": {
      "types": "./dist/types/ocr/index.d.ts",
      "import": "./dist/esm/ocr/index.js",
      "require": "./dist/cjs/ocr/index.js"
    },
    "./metadata": {
      "types": "./dist/types/metadata/index.d.ts",
      "import": "./dist/esm/metadata/index.js",
      "require": "./dist/cjs/metadata/index.js"
    },
    "./social": {
      "types": "./dist/types/social/index.d.ts",
      "import": "./dist/esm/social/index.js",
      "require": "./dist/cjs/social/index.js"
    },
    "./video": {
      "types": "./dist/types/video/index.d.ts",
      "import": "./dist/esm/video/index.js",
      "require": "./dist/cjs/video/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "image",
    "geo",
    "rate-limit",
    "clip",
    "dhash",
    "ffmpeg",
    "dto",
    "face-compreface",
    "face-video",
    "ocr",
    "metadata",
    "social",
    "video",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/memoriahub-packages/copy-license.mjs",
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../scripts/memoriahub-packages/write-dist-stubs.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "node --test",
    "test:run": "node --test"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "onnxruntime-node": "1.27.0",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^6.0.3"
  }
}
