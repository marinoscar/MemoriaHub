{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "setup:deps": "cd ../.. && npm run build --workspace=@memoriahub/enrichment-compute && npm run prisma:generate --workspace=api",
    "pretypecheck": "npm run setup:deps",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "pretest": "npm run setup:deps",
    "test": "jest --config ./test/jest.config.js --testPathIgnorePatterns='e2e'",
    "test:all": "jest --config ./test/jest.config.js",
    "test:watch": "jest --config ./test/jest.config.js --watch --testPathIgnorePatterns='e2e'",
    "test:cov": "jest --config ./test/jest.config.js --coverage --testPathIgnorePatterns='e2e'",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config ./test/jest.config.js --testPathIgnorePatterns='e2e'",
    "test:e2e": "jest --config ./test/jest.config.js --testRegex '.e2e.spec.ts$'",
    "test:unit": "jest --config ./test/jest.config.js --testPathIgnorePatterns='e2e'",
    "test:ci": "jest --config ./test/jest.config.js --ci --testPathIgnorePatterns='e2e'",
    "prisma": "node scripts/prisma-env.js",
    "prisma:generate": "node scripts/prisma-env.js generate",
    "prisma:migrate": "node scripts/prisma-env.js migrate deploy",
    "prisma:migrate:dev": "node scripts/prisma-env.js migrate dev",
    "prisma:studio": "node scripts/prisma-env.js studio",
    "prisma:seed": "node scripts/prisma-env.js db seed",
    "prisma:push": "node scripts/prisma-env.js db push",
    "catalog:permissions": "ts-node -P scripts/tsconfig.json --transpile-only scripts/generate-permission-catalog.ts",
    "db:compose": "platform db compose",
    "db:compose:check": "platform db compose --check",
    "db:sync": "platform db sync",
    "db:check": "platform db check",
    "db:check:database": "node scripts/platform-env.js db check --database",
    "db:drift": "node scripts/platform-env.js db drift",
    "db:baseline": "node scripts/platform-env.js db baseline",
    "db:test": "node scripts/test-db-connection.js",
    "credentials:migrate-legacy": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-legacy-credentials.ts",
    "storage:migrate-settings": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-storage-settings.ts",
    "android:migrate-legacy-releases": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-android-releases.ts",
    "db-backup:migrate-legacy": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-db-backup-settings.ts",
    "notifications:migrate-legacy": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-notifications.ts",
    "email:migrate-settings": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-email-settings.ts",
    "settings:verify": "ts-node -P scripts/tsconfig.json --transpile-only scripts/verify-settings-rows.ts",
    "sharing:import-media-shares": "ts-node -P scripts/tsconfig.json --transpile-only scripts/import-media-shares.ts",
    "settings:migrate-run-retention": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-run-retention-settings.ts",
    "settings:migrate-telemetry": "ts-node -P scripts/tsconfig.json --transpile-only scripts/migrate-telemetry-settings.ts",
    "ai:migrate-keys": "node dist/ai-port/migrate/ai-legacy-migrate.js",
    "ai:migrate-keys:dev": "ts-node -P scripts/tsconfig.json --transpile-only src/ai-port/migrate/ai-legacy-migrate.ts",
    "openapi:dump": "ts-node -P scripts/tsconfig.json --transpile-only scripts/dump-openapi.ts",
    "openapi:typecheck": "tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@app/shared": "*",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-sesv2": "^3.1068.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@marinoscar/platform-ai-providers": "0.1.0-next.29",
    "@marinoscar/platform-api": "0.1.0-next.29",
    "@marinoscar/platform-contract": "0.1.0-next.29",
    "@marinoscar/platform-db": "0.1.0-next.29",
    "@memoriahub/enrichment-compute": "0.1.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/web-push": "^3.6.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.9.0",
    "exifr": "^7.1.3",
    "exiftool-vendored": "35.21.0",
    "local-reverse-geocoder": "^0.16.7",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^9.0.3",
    "onnxruntime-node": "^1.31.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.x",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.2",
    "passport-custom": "^1.x",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.x",
    "typescript": "^6.0.3"
  },
  "prisma": {}
}
