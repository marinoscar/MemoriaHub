// =============================================================================
// Burst Detection
// =============================================================================

enum BurstGroupStatus {
  pending
  resolved
  dismissed
}

model BurstGroup {
  id                  String           @id @default(uuid()) @db.Uuid
  circleId            String           @map("circle_id") @db.Uuid
  status              BurstGroupStatus @default(pending)
  suggestedBestItemId String?          @map("suggested_best_item_id") @db.Uuid
  mediaCount          Int              @default(0) @map("media_count")
  capturedAt          DateTime?        @map("captured_at") @db.Timestamptz
  resolvedById        String?          @map("resolved_by_id") @db.Uuid
  resolvedAt          DateTime?        @map("resolved_at") @db.Timestamptz
  resolutionAction    String?          @map("resolution_action")
  keptCount           Int?             @map("kept_count")
  removedCount        Int?             @map("removed_count")
  confidence          Float?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  circle            Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  suggestedBestItem MediaItem?      @relation("BurstGroupSuggestedBest", fields: [suggestedBestItemId], references: [id], onDelete: SetNull)
  resolvedBy        User?           @relation("BurstGroupResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  items             MediaItem[]     @relation("BurstGroupItems")
  reviewRunItems    ReviewRunItem[]

  @@index([circleId, status])
  @@index([capturedAt])
  @@index([circleId, status, resolutionAction])
  @@map("burst_groups")
}

// =============================================================================
// Duplicate Detection
// =============================================================================

enum DuplicateGroupStatus {
  pending
  resolved
  dismissed
}

model DuplicateGroup {
  id                  String               @id @default(uuid()) @db.Uuid
  circleId            String               @map("circle_id") @db.Uuid
  status              DuplicateGroupStatus @default(pending)
  suggestedBestItemId String?              @map("suggested_best_item_id") @db.Uuid
  mediaCount          Int                  @default(0) @map("media_count")
  capturedAt          DateTime?            @map("captured_at") @db.Timestamptz
  resolvedById        String?              @map("resolved_by_id") @db.Uuid
  resolvedAt          DateTime?            @map("resolved_at") @db.Timestamptz
  resolutionAction    String?              @map("resolution_action")
  keptCount           Int?                 @map("kept_count")
  removedCount        Int?                 @map("removed_count")
  // Tightest-pair CLIP cosine similarity (0-1) across the group's members,
  // persisted so threshold filtering (resolve/dismiss-by-threshold, and now
  // review-run evaluation) runs as a real SQL predicate instead of a
  // read-time $queryRaw scan. Written by DuplicateDetectionService.recomputeGroupMeta
  // on every membership change and self-healed opportunistically at read
  // time; NULL when maxSim is genuinely uncomputable (fewer than two
  // members carry an embedding), matching BurstGroup.confidence. See
  // migration 20260726000000_duplicate_group_confidence and issue #190.
  confidence          Float?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  circle            Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  suggestedBestItem MediaItem?      @relation("DuplicateGroupSuggestedBest", fields: [suggestedBestItemId], references: [id], onDelete: SetNull)
  resolvedBy        User?           @relation("DuplicateGroupResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  items             MediaItem[]     @relation("DuplicateGroupItems")
  reviewRunItems    ReviewRunItem[]

  @@index([circleId, status])
  @@index([circleId, status, resolutionAction])
  @@index([circleId, status, confidence])
  @@map("duplicate_groups")
}
