// PLATFORM-ADOPTION-SHIM(RETRO-C1): replaced by @marinoscar/platform-db/schema/jobs.prisma

// =============================================================================
// Face Recognition
// =============================================================================

enum JobStatus {
  pending
  running
  succeeded
  failed
}

enum JobReason {
  upload
  rerun
  backfill
}

model EnrichmentJob {
  id              String    @id @default(uuid()) @db.Uuid
  type            String
  mediaItemId     String?   @map("media_item_id") @db.Uuid
  circleId        String?   @map("circle_id") @db.Uuid
  status          JobStatus @default(pending)
  reason          JobReason
  priority        Int       @default(0)
  providerKey     String?   @map("provider_key")
  modelVersion    String?   @map("model_version")
  payload         Json?     @db.JsonB
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  scheduledFor    DateTime? @map("scheduled_for") @db.Timestamptz
  rateLimitedAt   DateTime? @map("rate_limited_at") @db.Timestamptz
  rateLimitHits   Int       @default(0) @map("rate_limit_hits")
  // Distributed Worker Node claiming
  claimedByNodeId String?   @map("claimed_by_node_id") @db.Uuid
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz
  executor        String?   @map("executor") // 'server' | 'node'

  // Relations
  mediaItem     MediaItem?  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  circle        Circle?     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  claimedByNode WorkerNode? @relation(fields: [claimedByNodeId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([status, scheduledFor, priority, createdAt])
  @@index([mediaItemId])
  @@index([type, status])
  @@index([status, leaseExpiresAt])
  // Admin surfaces (migration 20260718000000_enrichment_jobs_admin_indexes):
  // - claimedByNodeId: WorkersPage polls groupBy(['claimedByNodeId','status'])
  //   every 5s (nodes.service getJobCountsForNodes) — seq scan without it.
  // - createdAt DESC: JobsPage default list orders by createdAt desc with no
  //   status filter (enrichment-admin.service listJobs) — seq scan + sort
  //   without it.
  @@index([claimedByNodeId])
  @@index([createdAt(sort: Desc)])
  // Admin stats/insights perf (issue #135, migration
  // 20260719010000_enrichment_jobs_stats_perf_indexes):
  // - (status, type, id): getStats() (polled every 5s) runs two UNCONDITIONAL
  //   aggregates — groupBy(['status']) and groupBy(['type','status']), both
  //   _count:{id:true} — with no WHERE clause at all. This single narrow
  //   covering index lets Postgres answer both via one Index-Only Scan
  //   instead of a full heap seq scan: `status` serves the plain groupBy,
  //   trailing `type` serves the (type,status) groupBy (order doesn't need
  //   to match index key order for an unconditional full-scan
  //   HashAggregate), and `id` is included so COUNT(id) never touches the
  //   heap. Deliberately distinct from the existing (type,status) index
  //   (different leading column; that one serves exact-match WHERE lookups
  //   elsewhere, this one serves the two full-table admin counts).
  @@index([status, type, id])
  // Two more indexes support getInsights()'s `attempts > 1` retried-jobs
  // count and its succeeded-job duration SUM/AVG/PERCENTILE_CONT queries
  // (both the windowed and the deliberately un-windowed lifetime variant —
  // see enrichment-admin.service.ts). Both are PARTIAL indexes (WHERE
  // clause), which Prisma's @@index() DSL cannot express — same limitation
  // as media_items_map_locations_idx and faces_embedding_vec_archive_hnsw_idx
  // above — so they exist only as raw SQL in migration
  // 20260719010000_enrichment_jobs_stats_perf_indexes, not as a directive
  // here:
  //   enrichment_jobs_attempts_gt1_idx ON (attempts) WHERE attempts > 1
  //   enrichment_jobs_succeeded_duration_idx ON
  //     (finished_at, started_at, type)
  //     WHERE status = 'succeeded' AND started_at IS NOT NULL
  //       AND finished_at IS NOT NULL
  @@map("enrichment_jobs")
}

// Lifetime per-type aggregate of terminal enrichment jobs. The nightly
// job_history_purge folds the rows it is about to delete into this table (in the
// same transaction) BEFORE deleting them, so all-time totals and average
// duration survive history purging for analytics and the insights dashboard.
// Only counts and total duration are kept (exactly mergeable) — percentiles are
// not stored here and remain computed live over the recent window.
model JobStatsRollup {
  type            String   @id
  succeededCount  Int      @default(0) @map("succeeded_count")
  failedCount     Int      @default(0) @map("failed_count")
  // Sum of (finishedAt - startedAt) in ms over succeeded jobs that had both
  // timestamps. Stored as double precision (exact for integers up to 2^53 ms).
  sumDurationMs   Float    @default(0) @map("sum_duration_ms")
  // Count of succeeded jobs that contributed a duration (avg denominator).
  durationSamples Int      @default(0) @map("duration_samples")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("job_stats_rollup")
}
