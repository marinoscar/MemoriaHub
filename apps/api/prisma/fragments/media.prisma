// =============================================================================
// Media Domain
// =============================================================================

enum MediaType {
  photo
  video
}

enum MediaSource {
  web
  cli
  android
  import
  sync
}

model MediaItem {
  // --- Identity and storage ---
  id              String        @id @default(uuid()) @db.Uuid
  storageObjectId String        @unique @map("storage_object_id") @db.Uuid
  storageObject   StorageObject @relation(fields: [storageObjectId], references: [id])
  circleId        String        @map("circle_id") @db.Uuid
  circle          Circle        @relation(fields: [circleId], references: [id])
  addedById       String        @map("added_by_id") @db.Uuid
  addedBy         User          @relation("MediaAddedBy", fields: [addedById], references: [id])

  // --- Audit timestamps ---
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // --- Core typed fields ---
  type             MediaType
  capturedAt       DateTime?   @map("captured_at") @db.Timestamptz
  capturedAtOffset Int?        @map("captured_at_offset") // UTC offset in minutes at capture time
  importedAt       DateTime    @default(now()) @map("imported_at") @db.Timestamptz
  source           MediaSource
  contentHash      String?     @map("content_hash")

  width            Int?
  height           Int?
  durationMs       Int?    @map("duration_ms")
  orientation      Int? // EXIF orientation tag (1–8), display-critical
  cameraMake       String? @map("camera_make")
  cameraModel      String? @map("camera_model")
  originalFilename String  @map("original_filename")
  metadata         Json?

  // --- User-added metadata ---
  description String?
  favorite    Boolean @default(false)

  // --- Lifecycle / soft-delete / archive ---
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz // soft-delete / trash; null = active
  archivedAt DateTime? @map("archived_at") @db.Timestamptz // archive state; null = not archived (active), non-null = archived

  // --- Import / sync provenance ---
  originalCreatedAt DateTime? @map("original_created_at") @db.Timestamptz // file creation date, distinct from capturedAt
  sourcePath        String?   @map("source_path") // original folder/path on the source device
  sourceDeviceId    String?   @map("source_device_id")
  sourceDeviceName  String?   @map("source_device_name")

  // --- Location / reverse-geocoding (first-class) ---
  takenLat          Float?    @map("taken_lat")
  takenLng          Float?    @map("taken_lng")
  takenAltitude     Float?    @map("taken_altitude")
  geoCountry        String?   @map("geo_country") // "Costa Rica", "United States"
  geoCountryCode    String?   @map("geo_country_code") // ISO 3166-1 alpha-2: "CR", "US"
  geoAdmin1         String?   @map("geo_admin1") // state / province / region
  geoAdmin2         String?   @map("geo_admin2") // county / canton (optional tier)
  geoLocality       String?   @map("geo_locality") // city / town
  geoPlaceName      String?   @map("geo_place_name") // POI / landmark / display label
  geoSource         String?   @map("geo_source") // provider that produced it
  geocodedAt        DateTime? @map("geocoded_at") @db.Timestamptz // when reverse geocoding ran; null = not yet geocoded
  coordSource       String?   @map("coord_source") // provenance of taken_lat/taken_lng: 'exif' | 'manual' | 'inferred'; null = no coordinates
  socialMediaSource String?   @map("social_media_source") // detected re-upload source: 'tiktok' | 'instagram' | 'facebook' | 'other'; null = clean/unknown. Written only by the social_media_detection handler; used to gate video enrichment.

  // --- Location Grouping (issue #373) ---
  // INVARIANT: whenever the raw geoCountry/geoAdmin1/geoLocality column is
  // non-null, its geoCanonical* counterpart is non-null too. The canonical
  // value is the matching LocationGroup's canonicalName when the raw value
  // resolves to a group (directly or via a LocationGroupAlias), otherwise it
  // is the raw value copied verbatim — never left null and never resolved
  // with a read-time fallback. This is deliberate: the read path that
  // populates these columns (fetchGeoGroupRows) is a Prisma `groupBy`, and
  // `groupBy` cannot express a COALESCE(canonical, raw) projection, so the
  // canonical column must always already hold the right display value.
  geoCanonicalCountry  String? @map("geo_canonical_country")
  geoCanonicalAdmin1   String? @map("geo_canonical_admin1")
  geoCanonicalLocality String? @map("geo_canonical_locality")

  // --- Burst Detection ---
  perceptualHash String? @map("perceptual_hash") // 64-bit dHash stored as unsigned decimal string
  sharpnessScore Float?  @map("sharpness_score") // variance-of-Laplacian
  burstUuid      String? @map("burst_uuid") // Apple EXIF MakerNote BurstUUID
  burstScore     Float?  @map("burst_score") // best-shot quality score
  burstGroupId   String? @map("burst_group_id") @db.Uuid

  // --- Duplicate Detection ---
  duplicateGroupId String? @map("duplicate_group_id") @db.Uuid

  // --- Relations ---
  albumItems             AlbumItem[]
  mediaTags              MediaTag[]
  // Face Recognition relations
  faces                  Face[]
  enrichmentJobs         EnrichmentJob[]
  faceStatus             MediaFaceStatus?
  profileForPeople       Person[]             @relation("PersonProfileMedia")
  // Auto-Tagging relations
  tagStatus              MediaTagStatus?
  // Video Auto-Tagging relations (epic #452, issue #454)
  transcript             MediaTranscript?
  // Metadata Re-run relations
  metadataStatus         MediaMetadataStatus?
  // Geocode Status relations
  geocodeStatus          MediaGeocodeStatus?
  // Semantic search embedding (1536-d, stored via raw SQL / pgvector)
  embedding              MediaItemEmbedding?
  // Burst Detection relations
  burstGroup             BurstGroup?          @relation("BurstGroupItems", fields: [burstGroupId], references: [id], onDelete: SetNull)
  suggestedForBursts     BurstGroup[]         @relation("BurstGroupSuggestedBest")
  // Duplicate Detection relations
  duplicateGroup         DuplicateGroup?      @relation("DuplicateGroupItems", fields: [duplicateGroupId], references: [id], onDelete: SetNull)
  suggestedForDuplicates DuplicateGroup[]     @relation("DuplicateGroupSuggestedBest")
  // Media Sharing relations
  shares                 MediaShare[]
  // Location Inference relations
  locationSuggestion     LocationSuggestion?
  // Social Media Detection relations
  socialStatus           MediaSocialStatus?
  // Album cover relations
  coverForAlbums         Album[]              @relation("AlbumCover")
  // AI Picture Enhancer relations
  enhancementsAsSource   MediaEnhancement[]   @relation("MediaEnhancementSource")
  enhancementsAsResult   MediaEnhancement[]   @relation("MediaEnhancementResult")
  // Workflow Automation relations
  workflowRunItems       WorkflowRunItem[]
  // Empty Trash at Scale relations
  trashEmptyRunItems     TrashEmptyRunItem[]
  // Memories relations (epic #300, issue #301)
  memoryItems            MemoryItem[]
  coverForMemories       Memory[]             @relation("MemoryCover")
  // Location Grouping relations (issue #373)
  locationGroupCovers    LocationGroup[]      @relation("LocationGroupCover")

  @@index([circleId])
  @@index([addedById])
  @@index([capturedAt])
  @@index([createdAt])
  @@index([contentHash])
  @@index([type])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([favorite])
  @@index([geoCountryCode])
  @@index([geoAdmin1])
  @@index([geoLocality])
  @@index([geoCanonicalCountry])
  @@index([geoCanonicalAdmin1])
  @@index([geoCanonicalLocality])
  @@index([burstUuid])
  @@index([burstGroupId])
  @@index([duplicateGroupId])
  @@index([circleId, perceptualHash])
  // Serves the Local Media Backup feed's cursor-based incremental scan
  // (node backup runs page media_items by updatedAt with an id tiebreak).
  // See NodeBackupConfig/NodeBackupRun below (issue #310, epic #308).
  @@index([updatedAt, id])
  // NOTE: a hand-authored partial composite index "media_items_map_locations_idx"
  // ON (circle_id, captured_at DESC, taken_lat, taken_lng) WHERE deleted_at IS NULL
  // AND archived_at IS NULL AND taken_lat IS NOT NULL AND taken_lng IS NOT NULL
  // also exists, added via raw SQL in migration 20260713130000_media_locations_index
  // to serve the Map View's location-aggregation query. Prisma's schema DSL cannot
  // express partial indexes (no WHERE clause support on @@index()), so it is not
  // representable here as a real directive — see that migration's header comment
  // for the full rationale (same hand-authored precedent as the "On This Day"
  // functional index in migration 20260615000000_media_oncethisday_index).
  @@map("media_items")
}

// Stores a 1536-d text embedding per media item for semantic (cosine-similarity) search.
// Kept separate from media_items because Prisma cannot read/write Unsupported vector columns.
// The embedding column is written and queried exclusively via raw SQL using pgvector operators.
// circle_id is denormalized here (no FK constraint) for efficient circle-scoped filtering.
model MediaItemEmbedding {
  mediaItemId String                      @id @map("media_item_id") @db.Uuid
  mediaItem   MediaItem                   @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  circleId    String                      @map("circle_id") @db.Uuid
  // Parentheses written as \u0028/\u0029 so the composer field reader accepts the type; Prisma decodes them (vector(1536)).
  embedding   Unsupported("vector\u00281536\u0029")
  model       String
  updatedAt   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([circleId])
  @@map("media_item_embedding")
}

model Album {
  id               String       @id @default(uuid()) @db.Uuid
  circleId         String       @map("circle_id") @db.Uuid
  circle           Circle       @relation(fields: [circleId], references: [id])
  addedById        String       @map("added_by_id") @db.Uuid
  addedBy          User         @relation("AlbumAddedBy", fields: [addedById], references: [id])
  name             String
  description      String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  items            AlbumItem[]
  // Media Sharing relations
  shares           MediaShare[]
  // Album cover pointer
  coverMediaItemId String?      @map("cover_media_item_id") @db.Uuid
  coverMediaItem   MediaItem?   @relation("AlbumCover", fields: [coverMediaItemId], references: [id], onDelete: SetNull)

  @@index([circleId])
  @@index([coverMediaItemId])
  @@map("albums")
}

model AlbumItem {
  id          String    @id @default(uuid()) @db.Uuid
  albumId     String    @map("album_id") @db.Uuid
  album       Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaItemId String    @map("media_item_id") @db.Uuid
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz

  @@unique([albumId, mediaItemId])
  @@index([albumId])
  @@map("album_items")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  circleId  String     @map("circle_id") @db.Uuid
  circle    Circle     @relation(fields: [circleId], references: [id])
  addedById String     @map("added_by_id") @db.Uuid
  addedBy   User       @relation("TagAddedBy", fields: [addedById], references: [id])
  name      String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  mediaTags MediaTag[]

  @@unique([circleId, name])
  @@index([circleId])
  @@map("tags")
}

enum MediaTagSource {
  manual
  ai
  system
}

model MediaTag {
  id          String         @id @default(uuid()) @db.Uuid
  tagId       String         @map("tag_id") @db.Uuid
  tag         Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  mediaItemId String         @map("media_item_id") @db.Uuid
  mediaItem   MediaItem      @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  source      MediaTagSource @default(manual) @map("source")
  addedAt     DateTime       @default(now()) @map("added_at") @db.Timestamptz

  @@unique([tagId, mediaItemId])
  @@index([mediaItemId])
  @@map("media_tags")
}

// =============================================================================
// Storage Insights
// =============================================================================

enum InsightsSnapshotStatus {
  computing
  ready
  failed
}

model InsightsSnapshot {
  id         String                 @id @default(uuid()) @db.Uuid
  status     InsightsSnapshotStatus @default(computing)
  metrics    Json?                  @db.JsonB
  computedAt DateTime?              @map("computed_at") @db.Timestamptz
  durationMs Int?                   @map("duration_ms")
  error      String?
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("insights_snapshots")
}

// =============================================================================
// Public Media Sharing
// =============================================================================

enum ShareTargetType {
  media_item
  album
}

model MediaShare {
  id          String          @id @default(uuid()) @db.Uuid
  token       String          @unique
  targetType  ShareTargetType @map("target_type")
  mediaItemId String?         @map("media_item_id") @db.Uuid
  albumId     String?         @map("album_id") @db.Uuid
  circleId    String          @map("circle_id") @db.Uuid
  createdById String          @map("created_by_id") @db.Uuid
  expiresAt   DateTime?       @map("expires_at") @db.Timestamptz
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  mediaItem MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  album     Album?     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  circle    Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User       @relation("MediaShareCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([circleId])
  @@index([createdById])
  @@index([mediaItemId])
  @@index([albumId])
  @@map("media_shares")
}
