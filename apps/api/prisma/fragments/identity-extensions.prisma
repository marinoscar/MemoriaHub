// =============================================================================
// App-owned back-relations (RETRO-J3, #606)
// =============================================================================
//
// What the domain package (`memoriahub.*` fragments, installed by memoriahub-db sync)
// does not own: the legacy platform tables (platform-*.legacy.prisma), the avatar side
// table (user-profile.prisma) and its pointer at the domain's `Person`.

extend model User {
  profile                        UserProfile?                    @relation("UserProfileOwner")
  aiCredentialsUpdated           AiProviderCredential[]          @relation("AiCredentialUpdater")
  faceCredentialsUpdated         FaceProviderCredential[]        @relation("FaceCredentialUpdater")
  storageCredentialsUpdated      StorageProviderCredential[]     @relation("StorageCredentialUpdater")
  geoCredentialsUpdated          GeoProviderCredential[]         @relation("GeoCredentialUpdater")
  mhLegacyNotifications          MhLegacyNotification[]          @relation("UserNotifications")
  mhLegacyPushSubscriptions      MhLegacyPushSubscription[]      @relation("UserPushSubscriptions")
  mhLegacyNotificationDeliveries MhLegacyNotificationDelivery[]  @relation("UserNotificationDeliveries")
  androidAppReleasesUploaded     MhLegacyAndroidAppRelease[]     @relation("AndroidAppReleaseUploader")
  notificationBroadcastsCreated  MhLegacyNotificationBroadcast[] @relation("NotificationBroadcastCreatedBy")
  notificationBroadcastsCanceled MhLegacyNotificationBroadcast[] @relation("NotificationBroadcastCanceledBy")
  databaseBackupsCreated         MhLegacyDatabaseBackupRun[]     @relation("DatabaseBackupCreatedBy")
  databaseBackupsRestored        MhLegacyDatabaseBackupRun[]     @relation("DatabaseBackupRestoredBy")
}

extend model StorageObject {
  legacyMigrationItems MhLegacyStorageMigrationItem[] @relation("MhLegacyStorageMigrationItemObject")
}

extend model Person {
  // Profile picture management relations (issue #354)
  linkedProfiles UserProfile[] @relation("UserLinkedPerson")
}
