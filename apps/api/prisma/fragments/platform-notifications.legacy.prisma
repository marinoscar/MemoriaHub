// PLATFORM-ADOPTION-SHIM(RETRO-D3): replaced by @marinoscar/platform-db/schema/notifications.prisma

// =============================================================================
// Notification Center (epic #240)
// =============================================================================

// review_queue_* types are refreshed STATE rows (see Notification's comment
// below); the remaining five are per-occurrence EVENT rows.
//
// `memories_ready` (epic #300, issue #311) is a COUNTED EVENT written through
// NotificationsService.upsertCountedEvent() with a 24h rolling window, so a
// generation run that creates six memories folds into ONE row reading
// "6 new memories in {circle}" rather than fanning out six. It is deliberately
// NOT a STATE type: STATE rows are protected by the raw-SQL partial unique
// index notifications_review_queue_live_uniq_idx, whose predicate lists only
// the four review_queue_* values, and there is no reason to widen that index
// for a type whose natural semantics are "N new things happened".
enum NotificationType {
  review_queue_bursts
  review_queue_duplicates
  review_queue_location_suggestions
  review_queue_enhancements
  upload_completed
  enrichment_failed
  workflow_run_completed
  share_expiring
  memories_ready
  admin_broadcast // epic #481, issue #488 — an admin announcement
  admin_broadcast_critical // same, marked critical: mandatory inbox row (bypasses user prefs and admin disabledTypes)
}

// Schema-only foundation for the in-app notification center (issue #244,
// child of epic #240). This change adds ONLY the model/enum/migration below
// — no producers, no API, no UI. See docs/specs/notifications.md once it
// lands for the full feature; the retention purge implied by the
// (dismissed_at, updated_at) and (read_at) indexes below is issue #248, not
// implemented here.
//
// STATE vs. EVENT notification types:
//   - The four `review_queue_*` types are STATE notifications: one row
//     tracks a user's whole pending-count for a given (circle, review
//     queue), and is refreshed in place — not appended — as the underlying
//     count changes. A circle with 929 pending duplicate groups must
//     produce exactly one row for that user, never 929.
//   - The remaining four types (upload_completed, enrichment_failed,
//     workflow_run_completed, share_expiring) are EVENT notifications: one
//     row per occurrence, appended freely, never deduplicated against each
//     other.
//
// DEDUP CONSTRAINT — raw SQL, not representable in Prisma's schema DSL:
//   A partial unique index on (user_id, circle_id, type) WHERE
//   dismissed_at IS NULL AND circle_id IS NOT NULL AND type IN
//   ('review_queue_bursts', 'review_queue_duplicates',
//   'review_queue_location_suggestions', 'review_queue_enhancements')
//   enforces "at most one LIVE (non-dismissed) row per (user, circle, type)"
//   for the four state types only. The partial WHERE is exactly why the
//   event types are exempt — an upload_completed row is never matched
//   against this index at all, so it is never deduplicated. circleId IS NOT
//   NULL is included in the predicate even though the column is nullable
//   because Postgres unique indexes treat every NULL as distinct from every
//   other NULL; without that clause two different global (circle_id = NULL)
//   notifications of the same type for the same user would NOT collide and
//   uniqueness would be silently defeated for that case, even though in
//   practice a review_queue_* row's circleId is always non-null (there is
//   no "global" review queue). See migration 20260805000000_add_notifications
//   for the actual index, named notifications_review_queue_live_uniq_idx —
//   the same hand-authored-raw-SQL precedent as media_items_gallery_idx,
//   media_items_map_locations_idx, people_circle_id_hidden_at_idx, and the
//   review_run_items partial uniques above.
model MhLegacyNotification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  circleId    String?          @map("circle_id") @db.Uuid
  type        NotificationType
  title       String
  body        String?
  link        String?
  data        Json?            @db.JsonB
  readAt      DateTime?        @map("read_at") @db.Timestamptz
  dismissedAt DateTime?        @map("dismissed_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user   User    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  circle Circle? @relation("CircleNotifications", fields: [circleId], references: [id], onDelete: Cascade)
  // Channel delivery audit (epic #481, issue #484)
  deliveries MhLegacyNotificationDelivery[] @relation("NotificationDeliveries")

  // unread-count query and unread filter
  @@index([userId, readAt])
  // paginated list, newest first
  @@index([userId, createdAt(sort: Desc)])
  // dismissed filtering
  @@index([userId, dismissedAt])
  // serves the #248 retention purge (stale dismissed rows / staleness by update time)
  @@index([dismissedAt, updatedAt])
  // serves the #248 retention purge (unread-forever sweep)
  @@index([readAt])
  // See this model's header comment: notifications_review_queue_live_uniq_idx,
  // a raw-SQL-only partial unique index, is added in migration
  // 20260805000000_add_notifications and is NOT representable here.
  @@map("mh_legacy_notifications")
}

// =============================================================================
// Web Push subscriptions (epic #481, issue #483)
// =============================================================================
//
// One row per browser PushSubscription (the object `pushManager.subscribe`
// returns). `endpoint` is UNIQUE ON ITS OWN, not per user: the same browser
// re-subscribing under a different signed-in user MOVES the row to the new
// owner rather than forking a duplicate that would keep pushing the old
// owner's notifications to a machine they no longer use.
//
// `p256dh`/`auth` are the browser's public encryption key and auth secret —
// needed to encrypt a payload for this endpoint, never returned by any route.
// `failureCount` counts consecutive non-404/410 send failures; the sender
// prunes the row at 5. A 404/410 from the push service prunes immediately.
model MhLegacyPushSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime? @map("expiration_time") @db.Timestamptz
  userAgent      String?   @map("user_agent")
  failureCount   Int       @default(0) @map("failure_count")
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mh_legacy_push_subscriptions")
}

// =============================================================================
// Notification channel deliveries (epic #481, issue #484)
// =============================================================================
//
// One row per (notification, non-inbox channel) delivery attempt — today only
// `push`. An AUDIT/diagnostic record, not a queue: it answers "why did this
// user never get pushed?" and is purged by the nightly notification_purge job
// after `notifications.retentionDays` (by `created_at`).
//
// Both FKs are SetNull, not Cascade: the delivery history outlives the inbox
// row (dismissed and purged) and the user (deleted) it was about. `type` is
// denormalized for the same reason — it must still be readable once the
// notification is gone. `channel` is a plain string ('inbox' | 'push') so a
// future channel needs no enum migration.
enum MhLegacyNotificationDeliveryStatus {
  queued
  sent
  failed

  @@map("MhLegacyNotificationDeliveryStatus")
}

model MhLegacyNotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String?                    @map("notification_id") @db.Uuid
  userId            String?                    @map("user_id") @db.Uuid
  type              NotificationType
  channel           String
  status            MhLegacyNotificationDeliveryStatus
  providerMessageId String?                    @map("provider_message_id")
  error             String?
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  notification MhLegacyNotification? @relation("NotificationDeliveries", fields: [notificationId], references: [id], onDelete: SetNull)
  user         User?         @relation("UserNotificationDeliveries", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("mh_legacy_notification_deliveries")
}

// =============================================================================
// Admin notification broadcasts (epic #481, issue #488)
// =============================================================================
//
// One row per announcement an administrator composes. The row is the record
// and the fan-out's durable state: `broadcast_start` claims it
// (scheduled -> sending, stamping `audienceCutoff`), `broadcast_chunk` jobs walk
// the audience 200 users at a time in id order, committing `cursorUserId` and
// `processedCount` with a compare-and-swap after every page, and the last chunk
// flips it to `sent`. A permanently failed job flips it to `failed`; resume
// continues from the cursor. See docs/specs/notifications.md.
//
// `draft` is reserved (no route produces it). `channels` is a subset of
// ['inbox','push','email']; a critical broadcast always includes 'inbox'.
// `recipientCount` is the audience size at the cutoff (a snapshot: users
// deactivated mid-fan-out are skipped, so `processedCount` may finish below it).
enum MhLegacyNotificationBroadcastStatus {
  draft
  scheduled
  sending
  sent
  canceled
  failed

  @@map("MhLegacyNotificationBroadcastStatus")
}

model MhLegacyNotificationBroadcast {
  id             String                      @id @default(uuid()) @db.Uuid
  title          String
  body           String
  link           String?
  ctaLabel       String?                     @map("cta_label")
  critical       Boolean                     @default(false)
  channels       String[]
  status         MhLegacyNotificationBroadcastStatus @default(scheduled)
  scheduledFor   DateTime?                   @map("scheduled_for") @db.Timestamptz
  audienceCutoff DateTime?                   @map("audience_cutoff") @db.Timestamptz
  recipientCount Int?                        @map("recipient_count")
  cursorUserId   String?                     @map("cursor_user_id") @db.Uuid
  processedCount Int                         @default(0) @map("processed_count")
  startedAt      DateTime?                   @map("started_at") @db.Timestamptz
  finishedAt     DateTime?                   @map("finished_at") @db.Timestamptz
  lastError      String?                     @map("last_error")
  createdById    String?                     @map("created_by_id") @db.Uuid
  canceledById   String?                     @map("canceled_by_id") @db.Uuid
  canceledAt     DateTime?                   @map("canceled_at") @db.Timestamptz
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  createdBy  User? @relation("NotificationBroadcastCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  canceledBy User? @relation("NotificationBroadcastCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([createdAt(sort: Desc)])
  @@map("mh_legacy_notification_broadcasts")
}
