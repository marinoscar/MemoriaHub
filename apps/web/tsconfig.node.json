{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  // `pwa/` is config-side code (issue #482): `vite.config.ts` imports it and
  // the React tree never does.
  "include": ["vite.config.ts", "pwa/**/*.ts"]
}
