# =============================================================================
# MemoriaHub application variables
# =============================================================================
# Appended to the generated .env.example by `npm run platform:infra:sync`. The
# platform variables above this block are generated; edit this file, never
# .env.example. Every value here is a default, not a secret: keep secrets in
# .env only.
#
# Commented keys are described in prose on purpose: the deploy wizard reads a
# commented KEY=value line as a declared variable. Do not put a trailing
# "# comment" after a value; Compose keeps it as part of the value.
#
# Production (memoriahub.marin.cr): set NODE_ENV=production, APP_URL,
# GOOGLE_CALLBACK_URL, POSTGRES_HOST/PORT/USER/PASSWORD/DB, POSTGRES_SSL=true
# (cloud PostgreSQL), JWT_SECRET and COOKIE_SECRET (openssl rand -base64 32).
# The deploy steps are in docs/platform-adoption/deploy-steps.md.
#
# Test authentication is enabled automatically when NODE_ENV is not
# production (the /api/auth/test/login endpoint, for E2E tests). Set
# TEST_AUTH_ENABLED to false to disable it in development. The API refuses to
# start with it on in production.
#
# Microsoft sign-in is not implemented in this app: no MICROSOFT_* variables.

# -----------------------------------------------------------------------------
# Container sizing (scope prod: app.prod.memory-limits.compose.yml)
# -----------------------------------------------------------------------------
# Size the container limit and the V8 heap together. The heap cap must sit
# below the container limit, with about 1 GB left for off-heap buffers (image
# decode, sharp, onnxruntime). The current pairing is 6G with 5120 MB of heap.
API_MEMORY_LIMIT=6G
API_CPU_LIMIT=4.0
WEB_MEMORY_LIMIT=128M
NODE_OPTIONS=--max-old-space-size=5120

# -----------------------------------------------------------------------------
# Database pool (Prisma)
# -----------------------------------------------------------------------------
# Prisma's default connection limit follows the host CPU count, which is wrong
# inside a CPU-limited container, so it is set explicitly. DB_POOL_TIMEOUT is
# in seconds. The interactive-transaction timeouts are in milliseconds; the
# Prisma default of 5000 ms is too tight under bulk-import load.
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=20
PRISMA_TX_TIMEOUT_MS=15000
PRISMA_TX_MAX_WAIT_MS=5000

# -----------------------------------------------------------------------------
# Device authorization
# -----------------------------------------------------------------------------
# Lifetime in days of a personal access token issued through the device flow
# (the CLI's login and the Android app's pairing). The platform's
# DEVICE_PAT_EXPIRY_DAYS is not read by this app.
DEVICE_PAT_TTL_DAYS=90

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Setting OTEL_DEBUG to true turns on OpenTelemetry diagnostic logging (development only).
# The Uptrace stack is retired; telemetry goes to the platform's GreptimeDB
# collector (telemetry.compose.yml).

# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# The storage driver (Amazon S3, Cloudflare R2, S3-compatible or the local disk),
# its bucket, region, endpoint and keys are RUNTIME configuration since RETRO-D1:
# Admin -> Settings -> Object Storage (/admin/settings/storage). No STORAGE_PROVIDER,
# S3_*, AWS_* or BACKUP_LOCAL_PATH variable is read. An upgrade copies their old
# values once with `npm run storage:migrate-settings --workspace=api -- --apply`
# (docs/runbooks/storage-configuration.md).

THUMBNAIL_MAX_DIM=800
THUMBNAIL_QUALITY=85

# -----------------------------------------------------------------------------
# Reverse and forward geocoding
# -----------------------------------------------------------------------------
# GEO_PROVIDER is the startup fallback for the reverse provider. The active
# provider is chosen in the admin UI (Geo Settings) and persisted there.
# offline uses the local GeoNames dataset and sends no GPS off the server;
# nominatim sends GPS coordinates to the Nominatim endpoint.
# Google reverse geocoding needs an API key saved in the admin UI, not here.
GEO_PROVIDER=offline
# Forward geocoding (place-name search) sends only the typed query, never photo
# GPS. It is off by default; GEO_FORWARD_SEARCH_ENABLED=true turns it on.
GEO_FORWARD_SEARCH_ENABLED=false
# GEO_FORWARD_PROVIDER is nominatim (default) or google. google needs the
# GOOGLE_MAPS_API_KEY variable, which is server-side only and never sent to a
# client; without it the search falls back to nominatim. NOMINATIM_BASE_URL
# overrides the Nominatim endpoint, for a private instance.
GEO_FORWARD_PROVIDER=nominatim

# -----------------------------------------------------------------------------
# Email (bootstrap defaults only; the admin UI owns the active settings)
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER is ses or smtp. ses reuses the AWS keys above, so those keys
# also need ses:SendEmail and ses:SendRawEmail, and the SES region is set by
# AWS_SES_REGION. smtp reads SMTP_HOST, SMTP_PORT (587), SMTP_USE_TLS (true),
# SMTP_USERNAME and SMTP_PASSWORD (encrypted into the setting on first boot).
# EMAIL_FROM_ADDRESS and EMAIL_FROM_NAME set the sender. Unverified SES
# accounts can send only to and from verified identities.

# -----------------------------------------------------------------------------
# Face recognition (CompreFace keyless core sidecar)
# -----------------------------------------------------------------------------
# FACE_COMPREFACE_URL is the sidecar base URL, reached on app-network.
FACE_COMPREFACE_URL=http://compreface-core:3000
# Cosine similarity for assigning a face to a known person (ArcFace, about 0.38).
FACE_MATCH_THRESHOLD=0.38
# pgvector uses the faces.embedding_vec HNSW index; app is a Float[] cosine scan
# kept for one release as a rollback.
FACE_VECTOR_BACKEND=pgvector
# Nearest-neighbour candidates read from the HNSW index before the centroid
# recompute or the nearest-archive pick (pgvector backend only).
FACE_MATCH_KNN_CANDIDATES=40
# Cosine similarity for clustering unknown faces; stricter than the match
# threshold. Singletons stay unknown below FACE_CLUSTER_MIN_SIZE members.
FACE_CLUSTER_THRESHOLD=0.45
FACE_CLUSTER_MIN_SIZE=2
# Auto-archive threshold for a face that matches a previously archived face
# (the face.autoArchive.matchThreshold setting overrides it at runtime).
FACE_ARCHIVE_MATCH_THRESHOLD=0.45
# Archived embeddings scanned per candidate when auto-archiving.
FACE_ARCHIVE_MAX_CANDIDATES=5000
# Longest image edge sent to face detection, in pixels. Raise it for small faces
# in wide shots; lower it on a memory-constrained host.
FACE_MAX_IMAGE_DIM=2000
# Hard kill-switches, both default true: FACE_AUTO_DETECT=false disables face
# detection on upload and FACE_AUTO_ARCHIVE=false disables auto-archive,
# regardless of the admin settings. Set them only in CI or test environments.

# -----------------------------------------------------------------------------
# AI auto-tagging
# -----------------------------------------------------------------------------
# Setting AUTO_TAG_ENABLED to false is a hard kill-switch for auto-tagging on upload,
# regardless of the features.autoTagging setting. Default true.
AUTO_TAG_ENABLED=true

# -----------------------------------------------------------------------------
# Memories
# -----------------------------------------------------------------------------
# Setting MEMORIES_ENABLED to false is a hard kill-switch for memory generation and the
# digest, regardless of the features.memories setting. Default true. The
# runtime toggle and every memories.* parameter are admin settings.

# -----------------------------------------------------------------------------
# Background job queue (the platform's jobs slice, RETRO-C1)
# -----------------------------------------------------------------------------
# The queue is the platform's: it is tuned by the JOBS_* variables of the
# generated section above (JOBS_WORKER_MODE, JOBS_WORKER_CONCURRENCY,
# JOBS_POLL_MS, JOBS_MAX_ATTEMPTS, JOBS_RETRY_*, JOBS_RATELIMIT_*,
# JOBS_JOB_TIMEOUT_MS, JOBS_REAPER_ENABLED, JOBS_SYSTEM_MODE_EXTRA_TYPES).
# The old ENRICHMENT_* names are still read for ONE release, with a deprecation
# warning at boot, and a JOBS_* value always wins:
# ENRICHMENT_WORKER_MODE (or ENRICHMENT_WORKER_ENABLED=false),
# ENRICHMENT_WORKER_CONCURRENCY, ENRICHMENT_JOB_POLL_MS, ENRICHMENT_JOB_TIMEOUT_MS,
# ENRICHMENT_MAX_ATTEMPTS, ENRICHMENT_RETRY_BASE_MS, ENRICHMENT_RETRY_MAX_MS,
# ENRICHMENT_RATELIMIT_BASE_MS, ENRICHMENT_RATELIMIT_MAX_MS,
# ENRICHMENT_RATELIMIT_MAX_HITS, ENRICHMENT_REAPER_ENABLED,
# ENRICHMENT_SYSTEM_MODE_EXTRA_TYPES. FACE_JOB_POLL_MS, FACE_WORKER_ENABLED and
# FACE_WORKER_CONCURRENCY (older aliases) are read the same way.
# ENRICHMENT_VIDEO_JOB_TIMEOUT_MS still sets the 20 minute execution profile of
# the three video job types (it is not a platform variable). ENRICHMENT_LEASE_MS
# and ENRICHMENT_STUCK_MINUTES are no longer read: the lease and the reaper's
# patience derive from each job type's execution profile.
# Two defaults keep the old queue's values when nothing is set: one worker slot
# (the platform default is two) and thumbnail_repair plus workflow_execute_batch
# in the system worker mode's claim set.
